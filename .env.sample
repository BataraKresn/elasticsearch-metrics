# Elasticsearch Metrics Stack - Environment Template
# Copy this file to .env and fill in your actual credentials

# Elasticsearch Connection (REQUIRED)
ES_URI=http://your_username:your_password@es-master:9200
ES_USERNAME=elastic
ES_PASSWORD=your_elasticsearch_password_here
ES_HOST=es-master
ES_PORT=9200

# Prometheus Exporters Ports (Default - adjust if needed)
ELASTICSEARCH_EXPORTER_PORT=9114
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080

# Metrics Collection Settings (Recommended defaults)
SCRAPE_INTERVAL=15s
EVALUATION_INTERVAL=15s

# Network Configuration (REQUIRED)
# Replace with your actual Tailscale IP or server IP
TAILSCALE_IP=100.xxx.xxx.xxx

# Additional Configuration Options (Optional)
# GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password
# PROMETHEUS_RETENTION_TIME=15d
# PROMETHEUS_STORAGE_RETENTION_SIZE=10GB

# Performance Tuning (Optional)
# PROMETHEUS_MEMORY_LIMIT=2g
# GRAFANA_MEMORY_LIMIT=1g
# ELASTICSEARCH_EXPORTER_MEMORY_LIMIT=512m

# Security Notes:
# 1. Use strong passwords for all services
# 2. Change default Grafana admin password
# 3. Ensure ES credentials match your Elasticsearch cluster
# 4. Restrict network access to monitoring ports
# 5. Never commit actual .env file to version control

# SECURITY WARNING - URGENT:
# The following files currently contain HARDCODED CREDENTIALS:
# - docker-compose.yml (--es.uri parameter)
# - scripts/setup.sh (curl commands)
# 
# TODO: Update these files to use ${ES_URI} and ${ES_PASSWORD} variables
# This is a SECURITY RISK in production environments!

# Network Requirements:
# - Docker network 'elasticsearch' must exist and be external
# - Elasticsearch cluster must be accessible on specified host:port
# - Firewall rules must allow access to exporter ports

# Usage:
# 1. Copy this file: cp .env.sample .env
# 2. Edit .env with your actual values
# 3. Run: docker-compose up -d
# 4. Access Grafana at: http://your_ip:3000
# 5. Access Prometheus at: http://your_ip:9090